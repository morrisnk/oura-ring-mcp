# Create an OAuth app: https://cloud.ouraring.com/oauth/applications
# Register this exact local redirect and run: node dist/index.js auth
OURA_CLIENT_ID=your_client_id
OURA_CLIENT_SECRET=your_client_secret
OURA_REDIRECT_URI=http://localhost:3000/callback

# Optional: defaults shown; request only what your tools need.
# OURA_SCOPES=personal daily heartrate workout tag session spo2

# Default: ~/.oura-mcp/credentials.json
# Containers: mount the parent directory on a durable volume, not just the file.
# OURA_CREDENTIALS_PATH=/data/credentials.json

# HTTP personal server: clients use MCP_SECRET; Oura uses OAuth.
# MCP_AUTH_MODE=static
# MCP_SECRET=generate_a_random_secret
# BASE_URL=https://your-server.example.com
# OURA_REFRESH_TOKEN=initial_seed_only_if_no_saved_credentials
